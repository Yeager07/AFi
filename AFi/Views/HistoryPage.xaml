<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AFi.ViewModels"
             xmlns:models="clr-namespace:AFi.Models"
             xmlns:converters="clr-namespace:AFi.Converters"
             x:Class="AFi.Views.HistoryPage"
             x:DataType="vm:HistoryViewModel"
             x:Name="PageRoot"
             Title="История"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*,Auto"
              Padding="15"
              RowSpacing="10">

            <!-- ==================== Фильтры ==================== -->
            <Border Grid.Row="0"
                    Stroke="{DynamicResource CardBorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="12"
                    BackgroundColor="{DynamicResource CardBackgroundColor}">
                <VerticalStackLayout Spacing="8">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="Период:"
                               VerticalOptions="Center"
                               FontSize="14"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Picker Grid.Column="1"
                                ItemsSource="{Binding FilterOptions}"
                                SelectedIndex="{Binding SelectedFilterIndex}"
                                FontSize="14"
                                TextColor="{DynamicResource TextPrimaryColor}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto,*"
                          ColumnSpacing="8"
                          IsVisible="{Binding IsCustomRangeSelected}">
                        <Label Grid.Column="0"
                               Text="С:"
                               VerticalOptions="Center"
                               FontSize="14"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <DatePicker Grid.Column="1"
                                    Date="{Binding CustomFromDate}"
                                    MaximumDate="{Binding MaxDate}"
                                    Format="dd.MM.yyyy"
                                    FontSize="14"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="2"
                               Text="По:"
                               VerticalOptions="Center"
                               FontSize="14"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <DatePicker Grid.Column="3"
                                    Date="{Binding CustomToDate}"
                                    MaximumDate="{Binding MaxDate}"
                                    Format="dd.MM.yyyy"
                                    FontSize="14"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                    </Grid>

                    <Button Text="Применить"
                            Command="{Binding ApplyCustomRangeCommand}"
                            IsVisible="{Binding IsCustomRangeSelected}"
                            BackgroundColor="{DynamicResource PrimaryColor}"
                            TextColor="{DynamicResource PrimaryTextColor}"
                            CornerRadius="8"
                            HeightRequest="40"
                            FontSize="14" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="Категория:"
                               VerticalOptions="Center"
                               FontSize="14"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Picker Grid.Column="1"
                                ItemsSource="{Binding CategoryFilterItems}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedIndex="{Binding SelectedCategoryIndex}"
                                FontSize="14"
                                TextColor="{DynamicResource TextPrimaryColor}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- ==================== Итоговые карточки + кнопка «Выбрать» ==================== -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,Auto" ColumnSpacing="6">

                <Border Grid.Column="0"
                        Stroke="{DynamicResource CardBorderColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="10"
                        BackgroundColor="{DynamicResource CardBackgroundColor}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Доход"
                               FontSize="11"
                               TextColor="{DynamicResource TextSecondaryColor}" />
                        <Label Text="{Binding SummaryIncome, StringFormat='{0:N0} ₽'}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource SuccessColor}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        Stroke="{DynamicResource CardBorderColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="10"
                        BackgroundColor="{DynamicResource CardBackgroundColor}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Расход"
                               FontSize="11"
                               TextColor="{DynamicResource TextSecondaryColor}" />
                        <Label Text="{Binding SummaryExpense, StringFormat='{0:N0} ₽'}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource DangerColor}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2"
                        Stroke="{DynamicResource CardBorderColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="10"
                        BackgroundColor="{DynamicResource CardBackgroundColor}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Баланс"
                               FontSize="11"
                               TextColor="{DynamicResource TextSecondaryColor}" />
                        <Label Text="{Binding SummaryBalance, StringFormat='{0:N0} ₽'}"
                               FontSize="14"
                               FontAttributes="Bold">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsBalanceNegative}"
                                             Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource DangerColor}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsBalanceNegative}"
                                             Value="False">
                                    <Setter Property="TextColor" Value="{DynamicResource SuccessColor}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <Button Grid.Column="3"
                        Text="Выбрать"
                        Command="{Binding EnterSelectionModeCommand}"
                        IsVisible="{Binding CanEnterSelectionMode}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource PrimaryColor}"
                        BorderColor="{DynamicResource PrimaryColor}"
                        BorderWidth="1"
                        CornerRadius="8"
                        FontSize="12"
                        Padding="10,0"
                        HeightRequest="40"
                        VerticalOptions="Center" />
            </Grid>

            <!-- ==================== Список + пагинация ==================== -->
            <Grid Grid.Row="2" RowDefinitions="*,Auto,Auto" RowSpacing="8">

                <CollectionView Grid.Row="0"
                                ItemsSource="{Binding Transactions}"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="Нет операций за выбранный период"
                               FontSize="14"
                               TextColor="{DynamicResource TextSecondaryColor}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Transaction">
                            <Grid>

                                <!-- ==================== ОБЫЧНЫЙ РЕЖИМ: карточка со свайпом ==================== -->
                                <SwipeView IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsSelectionMode, Converter={StaticResource InverseBoolConverter}}"
                                           Margin="0,4">
                                    <SwipeView.RightItems>
                                        <SwipeItems Mode="Reveal">
                                            <SwipeItemView>
                                                <Border StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 8"
                                                        BackgroundColor="{DynamicResource DangerColor}"
                                                        WidthRequest="95"
                                                        Padding="0"
                                                        Margin="6,0,0,0">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteTransactionCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="Удалить"
                                                           TextColor="{DynamicResource PrimaryTextColor}"
                                                           FontAttributes="Bold"
                                                           FontSize="14"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>
                                            </SwipeItemView>
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <Border Stroke="{DynamicResource CardBorderColor}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="12"
                                            BackgroundColor="{DynamicResource CardBackgroundColor}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.HandleCardTapCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <Grid ColumnDefinitions="*,Auto"
                                              RowDefinitions="Auto,Auto">

                                            <Label Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding DisplayCategoryName}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource TextPrimaryColor}" />

                                            <Label Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Amount, StringFormat='{0:N0} ₽'}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="End">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding Type}"
                                                                 Value="1">
                                                        <Setter Property="TextColor" Value="{DynamicResource DangerColor}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding Type}"
                                                                 Value="0">
                                                        <Setter Property="TextColor" Value="{DynamicResource SuccessColor}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>

                                            <Label Grid.Row="1" Grid.Column="0"
                                                   Grid.ColumnSpan="2"
                                                   FontSize="12"
                                                   TextColor="{DynamicResource TextSecondaryColor}">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0:dd.MM.yyyy} · {1}">
                                                        <Binding Path="Date" />
                                                        <Binding Path="Note" />
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>

                                        </Grid>
                                    </Border>
                                </SwipeView>

                                <!-- ==================== РЕЖИМ ВЫБОРА: карточка без свайпа ==================== -->
                                <Border IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsSelectionMode}"
                                        Stroke="{DynamicResource CardBorderColor}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="12"
                                        Margin="0,4"
                                        BackgroundColor="{DynamicResource CardBackgroundColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.HandleCardTapCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          RowDefinitions="Auto,Auto">

                                        <Border Grid.Row="0" Grid.RowSpan="2"
                                                Grid.Column="0"
                                                WidthRequest="26"
                                                HeightRequest="26"
                                                StrokeShape="RoundRectangle 13"
                                                Stroke="{DynamicResource PrimaryColor}"
                                                StrokeThickness="2"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                VerticalOptions="Center"
                                                HorizontalOptions="Start"
                                                Margin="0,0,10,0">
                                            <Label Text="✓"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource PrimaryColor}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding IsSelected}" />
                                        </Border>

                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding DisplayCategoryName}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimaryColor}" />

                                        <Label Grid.Row="0" Grid.Column="2"
                                               Text="{Binding Amount, StringFormat='{0:N0} ₽'}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               HorizontalOptions="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding Type}"
                                                             Value="1">
                                                    <Setter Property="TextColor" Value="{DynamicResource DangerColor}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding Type}"
                                                             Value="0">
                                                    <Setter Property="TextColor" Value="{DynamicResource SuccessColor}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <Label Grid.Row="1" Grid.Column="1"
                                               Grid.ColumnSpan="2"
                                               FontSize="12"
                                               TextColor="{DynamicResource TextSecondaryColor}">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0:dd.MM.yyyy} · {1}">
                                                    <Binding Path="Date" />
                                                    <Binding Path="Note" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>

                                    </Grid>
                                </Border>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Grid.Row="1"
                        Text="Показать ещё"
                        Command="{Binding LoadMoreCommand}"
                        IsVisible="{Binding HasMoreItems}"
                        BackgroundColor="{DynamicResource PrimaryColor}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        CornerRadius="8"
                        HeightRequest="44"
                        FontSize="14" />

                <Label Grid.Row="2"
                       Text="{Binding StatusMessage}"
                       FontSize="12"
                       TextColor="{DynamicResource TextSecondaryColor}"
                       HorizontalOptions="Center" />

            </Grid>
        </Grid>

        <!-- ==================== Панель мультивыбора ==================== -->
        <Border VerticalOptions="End"
                IsVisible="{Binding IsSelectionMode}"
                BackgroundColor="#2B2B2B"
                Stroke="Transparent"
                StrokeThickness="0"
                Padding="15,12"
                Margin="0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                <Label Grid.Column="0"
                       Text="✕"
                       FontSize="22"
                       TextColor="White"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelSelectionCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Grid.Column="1"
                       Text="{Binding SelectedCount, StringFormat='Выбрано: {0}'}"
                       FontSize="16"
                       TextColor="White"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />

                <Button Grid.Column="2"
                        Text="Удалить"
                        Command="{Binding DeleteSelectedCommand}"
                        IsEnabled="{Binding HasSelection}"
                        BackgroundColor="{DynamicResource DangerColor}"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="40"
                        FontSize="14"
                        Padding="16,0" />
            </Grid>
        </Border>
    </Grid>

</ContentPage>