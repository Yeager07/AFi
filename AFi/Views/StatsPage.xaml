<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AFi.ViewModels"
             xmlns:models="clr-namespace:AFi.Models"
             xmlns:converters="clr-namespace:AFi.Converters"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="AFi.Views.StatsPage"
             x:DataType="vm:StatsViewModel"
             x:Name="PageRoot"
             Title="Статистика"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:IsNotEmptyConverter x:Key="IsNotEmptyConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="12">

            <!-- ==================== Фильтр периода ==================== -->
            <Border Stroke="{DynamicResource CardBorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="12"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    IsVisible="{Binding IsFilterVisible}">
                <VerticalStackLayout Spacing="8">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="Период:"
                               VerticalOptions="Center"
                               FontSize="14"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <Picker Grid.Column="1"
                                ItemsSource="{Binding FilterOptions}"
                                SelectedIndex="{Binding SelectedFilterIndex}"
                                FontSize="14"
                                TextColor="{DynamicResource TextPrimaryColor}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto,*"
                          ColumnSpacing="8"
                          IsVisible="{Binding IsCustomRangeSelected}">
                        <Label Grid.Column="0"
                               Text="С:"
                               VerticalOptions="Center"
                               FontSize="14"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <DatePicker Grid.Column="1"
                                    Date="{Binding CustomFromDate}"
                                    MaximumDate="{Binding MaxDate}"
                                    Format="dd.MM.yyyy"
                                    FontSize="14"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label Grid.Column="2"
                               Text="По:"
                               VerticalOptions="Center"
                               FontSize="14"
                               TextColor="{DynamicResource TextPrimaryColor}" />
                        <DatePicker Grid.Column="3"
                                    Date="{Binding CustomToDate}"
                                    MaximumDate="{Binding MaxDate}"
                                    Format="dd.MM.yyyy"
                                    FontSize="14"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                    </Grid>

                    <Button Text="Применить"
                            Command="{Binding ApplyCustomRangeCommand}"
                            IsVisible="{Binding IsCustomRangeSelected}"
                            BackgroundColor="{DynamicResource PrimaryColor}"
                            TextColor="{DynamicResource PrimaryTextColor}"
                            CornerRadius="8"
                            HeightRequest="40"
                            FontSize="14" />

                </VerticalStackLayout>
            </Border>

            <!-- ==================== Итоговые карточки ==================== -->
            <VerticalStackLayout Spacing="4">

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">

                    <Border Grid.Column="0"
                            Stroke="{DynamicResource CardBorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="10"
                            BackgroundColor="{DynamicResource CardBackgroundColor}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Доход"
                                   FontSize="11"
                                   TextColor="{DynamicResource TextSecondaryColor}" />
                            <Label Text="{Binding SummaryIncome, StringFormat='{0:N0} ₽'}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource SuccessColor}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            Stroke="{DynamicResource CardBorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="10"
                            BackgroundColor="{DynamicResource CardBackgroundColor}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Расход"
                                   FontSize="11"
                                   TextColor="{DynamicResource TextSecondaryColor}" />
                            <Label Text="{Binding SummaryExpense, StringFormat='{0:N0} ₽'}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource DangerColor}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2"
                            Stroke="{DynamicResource CardBorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="10"
                            BackgroundColor="{DynamicResource CardBackgroundColor}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Баланс"
                                   FontSize="11"
                                   TextColor="{DynamicResource TextSecondaryColor}" />
                            <Label Text="{Binding SummaryBalance, StringFormat='{0:N0} ₽'}"
                                   FontSize="14"
                                   FontAttributes="Bold">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsBalanceNegative}"
                                                 Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource DangerColor}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsBalanceNegative}"
                                                 Value="False">
                                        <Setter Property="TextColor" Value="{DynamicResource SuccessColor}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Text="{Binding SummaryPeriodLabel, StringFormat='Сводка {0}'}"
                       FontSize="11"
                       TextColor="{DynamicResource TextSecondaryColor}"
                       HorizontalOptions="Center" />

            </VerticalStackLayout>

            <!-- ==================== Переключатель диаграмм ==================== -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">

                <Button Grid.Column="0"
                        Text="Круговая"
                        Command="{Binding SelectDonutModeCommand}"
                        CornerRadius="8"
                        HeightRequest="42"
                        FontSize="14">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding ChartModeIndex}"
                                     Value="0">
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding ChartModeIndex}"
                                     Value="1">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
                            <Setter Property="BorderColor" Value="{DynamicResource PrimaryColor}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Grid.Column="1"
                        Text="Динамика"
                        Command="{Binding SelectBarModeCommand}"
                        CornerRadius="8"
                        HeightRequest="42"
                        FontSize="14">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding ChartModeIndex}"
                                     Value="1">
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding ChartModeIndex}"
                                     Value="0">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
                            <Setter Property="BorderColor" Value="{DynamicResource PrimaryColor}" />
                            <Setter Property="BorderWidth" Value="1" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

            </Grid>

            <!-- ==================== Режим «Круговая» ==================== -->
            <VerticalStackLayout IsVisible="{Binding IsDonutMode}"
                                 Spacing="12">

                <Label Text="Расходы по категориям"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       Margin="0,4,0,0" />

                <Border Stroke="{DynamicResource CardBorderColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="10"
                        BackgroundColor="{DynamicResource CardBackgroundColor}"
                        HeightRequest="280">
                    <Grid>
                        <microcharts:ChartView Chart="{Binding ExpenseChart}"
                                               IsVisible="{Binding HasNoData, Converter={StaticResource InverseBoolConverter}}" />

                        <Label Text="{Binding TotalText}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               InputTransparent="True"
                               IsVisible="{Binding HasNoData, Converter={StaticResource InverseBoolConverter}}" />

                        <Label Text="Нет расходов за выбранный период"
                               FontSize="14"
                               TextColor="{DynamicResource TextSecondaryColor}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               IsVisible="{Binding HasNoData}" />
                    </Grid>
                </Border>

                <Label Text="Нажмите на категорию ниже, чтобы увидеть все операции этой категории"
                       FontSize="11"
                       TextColor="{DynamicResource TextSecondaryColor}"
                       HorizontalOptions="Center"
                       IsVisible="{Binding HasNoData, Converter={StaticResource InverseBoolConverter}}" />

                <!-- Заголовки колонок легенды -->
                <Grid ColumnDefinitions="20,*,Auto,Auto"
                      ColumnSpacing="10"
                      Padding="4,2"
                      IsVisible="{Binding HasNoData, Converter={StaticResource InverseBoolConverter}}">
                    <Label Grid.Column="1"
                           Text="Категория"
                           FontSize="11"
                           TextColor="{DynamicResource TextSecondaryColor}"
                           FontAttributes="Bold" />
                    <Label Grid.Column="2"
                           Text="Сумма"
                           FontSize="11"
                           TextColor="{DynamicResource TextSecondaryColor}"
                           FontAttributes="Bold"
                           HorizontalOptions="End" />
                    <Label Grid.Column="3"
                           Text="Доля"
                           FontSize="11"
                           TextColor="{DynamicResource TextSecondaryColor}"
                           FontAttributes="Bold"
                           WidthRequest="50"
                           HorizontalOptions="End" />
                </Grid>

                <!-- Легенда (кликабельная) -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding LegendItems}"
                                     Spacing="6"
                                     IsVisible="{Binding HasNoData, Converter={StaticResource InverseBoolConverter}}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:LegendItem">
                            <Border Stroke="{DynamicResource CardBorderColor}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,6"
                                    BackgroundColor="{DynamicResource CardBackgroundColor}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.GoToHistoryCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="20,*,Auto,Auto"
                                      ColumnSpacing="10">

                                    <Border Grid.Column="0"
                                            WidthRequest="16"
                                            HeightRequest="16"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 4"
                                            BackgroundColor="{Binding Color}"
                                            VerticalOptions="Center" />

                                    <HorizontalStackLayout Grid.Column="1"
                                                           Spacing="6"
                                                           VerticalOptions="Center">
                                        <Label Text="{Binding Icon}"
                                               FontSize="16"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding Icon, Converter={StaticResource IsNotEmptyConverter}}" />
                                        <Label Text="{Binding CategoryName}"
                                               FontSize="14"
                                               TextColor="{DynamicResource TextPrimaryColor}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <Label Grid.Column="2"
                                           Text="{Binding AmountText}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextPrimaryColor}"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End" />

                                    <Label Grid.Column="3"
                                           Text="{Binding PercentText}"
                                           FontSize="12"
                                           TextColor="{DynamicResource TextSecondaryColor}"
                                           WidthRequest="50"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- ==================== Режим «Динамика» ==================== -->
            <VerticalStackLayout IsVisible="{Binding IsBarMode}"
                                 Spacing="12">

                <Label Text="Доходы по месяцам"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       Margin="0,4,0,0" />

                <Border Stroke="{DynamicResource CardBorderColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="10"
                        BackgroundColor="{DynamicResource CardBackgroundColor}"
                        HeightRequest="220">
                    <microcharts:ChartView Chart="{Binding IncomeBarChart}" />
                </Border>

                <Label Text="Расходы по месяцам"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       Margin="0,8,0,0" />

                <Border Stroke="{DynamicResource CardBorderColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="10"
                        BackgroundColor="{DynamicResource CardBackgroundColor}"
                        HeightRequest="220">
                    <microcharts:ChartView Chart="{Binding ExpenseBarChart}" />
                </Border>

                <Label Text="Диаграммы показывают последние 6 месяцев — независимо от фильтра выше."
                       FontSize="11"
                       TextColor="{DynamicResource TextSecondaryColor}"
                       HorizontalOptions="Center"
                       Margin="0,4,0,0" />

            </VerticalStackLayout>

            <Label Text="{Binding StatusMessage}"
                   FontSize="12"
                   TextColor="{DynamicResource TextSecondaryColor}"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>