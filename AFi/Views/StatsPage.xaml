<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AFi.ViewModels"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="AFi.Views.StatsPage"
             x:DataType="vm:StatsViewModel"
             Title="Статистика">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Статистика"
                   FontSize="24"
                   FontAttributes="Bold" />

            <Label Text="Заглушка для проверки Microcharts. Полноценный экран появится на шаге 3.2."
                   FontSize="13"
                   TextColor="Gray" />

            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="15"
                    HeightRequest="320">
                <Grid>
                    <microcharts:ChartView Chart="{Binding TestChart}" />

                    <Label Text="{Binding TotalText}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           InputTransparent="True" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>