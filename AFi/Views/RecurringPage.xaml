<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AFi.ViewModels"
             xmlns:models="clr-namespace:AFi.Models"
             xmlns:converters="clr-namespace:AFi.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AFi.Views.RecurringPage"
             x:DataType="vm:RecurringViewModel"
             x:Name="PageRoot"
             Title="Напоминания"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto,*,Auto"
              Padding="15"
              RowSpacing="12">

            <!-- ==================== Верхняя панель ==================== -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">

                <Button Grid.Column="0"
                        Text="+ Добавить напоминание"
                        Command="{Binding AddPaymentCommand}"
                        BackgroundColor="{DynamicResource SuccessColor}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        CornerRadius="8"
                        HeightRequest="48"
                        FontSize="15" />

                <Button Grid.Column="1"
                        Text="Выбрать"
                        Command="{Binding EnterSelectionModeCommand}"
                        IsVisible="{Binding CanEnterSelectionMode}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource PrimaryColor}"
                        BorderColor="{DynamicResource PrimaryColor}"
                        BorderWidth="1"
                        CornerRadius="8"
                        HeightRequest="48"
                        FontSize="13"
                        Padding="12,0" />
            </Grid>

            <!-- ==================== Список напоминаний ==================== -->
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Payments}"
                            SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="10"
                                         Padding="20"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="🔔"
                               FontSize="48"
                               HorizontalOptions="Center" />
                        <Label Text="Пока нет напоминаний"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               HorizontalOptions="Center" />
                        <Label Text="Добавьте первое, чтобы не забывать о регулярных платежах"
                               FontSize="13"
                               TextColor="{DynamicResource TextSecondaryColor}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:RecurringPayment">
                        <Grid>

                            <!-- ==================== ОБЫЧНЫЙ РЕЖИМ ==================== -->
                            <Border IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsSelectionMode, Converter={StaticResource InverseBoolConverter}}"
                                    Stroke="{DynamicResource CardBorderColor}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12"
                                    Margin="0,4"
                                    BackgroundColor="{DynamicResource CardBackgroundColor}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.HandleCardTapCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="10"
                                      RowDefinitions="Auto,Auto">

                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding DisplayName}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextPrimaryColor}" />

                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Amount, StringFormat='{0:N0} ₽'}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           HorizontalOptions="End"
                                           TextColor="{DynamicResource TextPrimaryColor}" />

                                    <Label Grid.Row="1" Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding Subtitle}"
                                           FontSize="12"
                                           TextColor="{DynamicResource TextSecondaryColor}"
                                           VerticalOptions="Center" />

                                    <Switch Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                            IsToggled="{Binding IsEnabled}"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            OnColor="{DynamicResource SuccessColor}"
                                            ThumbColor="{DynamicResource PrimaryTextColor}">
                                        <Switch.Behaviors>
                                            <toolkit:EventToCommandBehavior
                                                EventName="Toggled"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ToggleEnabledCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Switch.Behaviors>
                                    </Switch>

                                </Grid>
                            </Border>

                            <!-- ==================== РЕЖИМ ВЫБОРА ==================== -->
                            <Border IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsSelectionMode}"
                                    Stroke="{DynamicResource CardBorderColor}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12"
                                    Margin="0,4"
                                    BackgroundColor="{DynamicResource CardBackgroundColor}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.HandleCardTapCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="10"
                                      RowDefinitions="Auto,Auto">

                                    <!-- Кружок выбора -->
                                    <Border Grid.Row="0" Grid.RowSpan="2"
                                            Grid.Column="0"
                                            WidthRequest="26"
                                            HeightRequest="26"
                                            StrokeShape="RoundRectangle 13"
                                            Stroke="{DynamicResource PrimaryColor}"
                                            StrokeThickness="2"
                                            BackgroundColor="Transparent"
                                            Padding="0"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Start">
                                        <Label Text="✓"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource PrimaryColor}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding IsSelected}" />
                                    </Border>

                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextPrimaryColor}" />

                                    <Label Grid.Row="0" Grid.Column="2"
                                           Text="{Binding Amount, StringFormat='{0:N0} ₽'}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           HorizontalOptions="End"
                                           TextColor="{DynamicResource TextPrimaryColor}" />

                                    <Label Grid.Row="1" Grid.Column="1"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding Subtitle}"
                                           FontSize="12"
                                           TextColor="{DynamicResource TextSecondaryColor}" />

                                </Grid>
                            </Border>

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- ==================== Статус ==================== -->
            <Label Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   FontSize="12"
                   TextColor="{DynamicResource TextSecondaryColor}"
                   HorizontalOptions="Center" />

        </Grid>

        <!-- ==================== Панель мультивыбора ==================== -->
        <Border VerticalOptions="End"
                IsVisible="{Binding IsSelectionMode}"
                BackgroundColor="{DynamicResource ShellBackgroundColor}"
                Stroke="{DynamicResource CardBorderColor}"
                StrokeThickness="1"
                Padding="15,12"
                Margin="0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                <Label Grid.Column="0"
                       Text="✕"
                       FontSize="22"
                       TextColor="{DynamicResource ShellTextColor}"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelSelectionCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Grid.Column="1"
                       Text="{Binding SelectedCount, StringFormat='Выбрано: {0}'}"
                       FontSize="16"
                       TextColor="{DynamicResource ShellTextColor}"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />

                <Button Grid.Column="2"
                        Text="Удалить"
                        Command="{Binding DeleteSelectedCommand}"
                        IsEnabled="{Binding HasSelection}"
                        BackgroundColor="{DynamicResource DangerColor}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        CornerRadius="8"
                        HeightRequest="40"
                        FontSize="14"
                        Padding="16,0" />
            </Grid>
        </Border>
    </Grid>

</ContentPage>