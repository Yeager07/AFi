<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AFi.ViewModels"
             xmlns:models="clr-namespace:AFi.Models"
             x:Class="AFi.Views.MainPage"
             x:DataType="vm:MainViewModel"
             x:Name="PageRoot"
             Title="AFi">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- ==================== Карточка баланса ==================== -->
            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="20">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Текущий баланс"
                        FontSize="14"
                        TextColor="Gray" />
                    <Label Text="{Binding CurrentBalance, StringFormat='{0:N0} ₽'}"
                        FontSize="30"
                        FontAttributes="Bold">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                        Binding="{Binding IsBalanceNegative}"
                                        Value="True">
                                <Setter Property="TextColor" Value="#D32F2F" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label"
                                        Binding="{Binding IsBalanceNegative}"
                                        Value="False">
                                <Setter Property="TextColor" Value="#2E7D32" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>
            
            <!-- ==================== Форма добавления ==================== -->
            <Border Stroke="LightGray"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 10"
            Padding="15">
                <VerticalStackLayout Spacing="10">

                    <Label Text="{Binding FormTitle}"
                    FontSize="18"
                    FontAttributes="Bold" />

                    <!-- Сумма -->
                    <Label Text="Сумма" FontSize="14" />
                    <Entry Placeholder="Например, 500"
                           Keyboard="Numeric"
                           Text="{Binding AmountText}" />

                    <!-- Тип -->
                    <Label Text="Тип" FontSize="14" />
                    <Picker ItemsSource="{Binding TypeOptions}"
                            SelectedIndex="{Binding SelectedTypeIndex}" />

                    <!-- Категория -->
                    <Label Text="Категория" FontSize="14" />
                    <Picker ItemsSource="{Binding AvailableCategories}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedCategory}" />

                    <!-- Дата -->
                    <Label Text="Дата" FontSize="14" />
                    <DatePicker Date="{Binding Date}" Format="dd.MM.yyyy" />

                    <!-- Комментарий -->
                    <Label Text="Комментарий (необязательно)" FontSize="14" />
                    <Entry Placeholder="Например, закупка зерна"
                           Text="{Binding Note}" />

                    <!-- Кнопка сохранения -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,10,0,0">

                        <Button Grid.Column="0"
                                Text="{Binding SubmitButtonText}"
                                Command="{Binding SaveCommand}"
                                BackgroundColor="#512BD4"
                                TextColor="White"
                                CornerRadius="8"
                                HeightRequest="48" />

                        <Button Grid.Column="1"
                                Text="Отмена"
                                Command="{Binding CancelEditCommand}"
                                IsVisible="{Binding IsEditing}"
                                BackgroundColor="Transparent"
                                TextColor="#512BD4"
                                BorderColor="#512BD4"
                                BorderWidth="1"
                                CornerRadius="8"
                                HeightRequest="48"
                                Padding="16,0" />

                    </Grid>

                    <!-- Статус -->
                    <Label Text="{Binding StatusMessage}"
                           FontSize="13"
                           TextColor="Gray"
                           HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Border>

            <!-- ==================== Список последних операций ==================== -->
            <Label Text="Последние операции"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <CollectionView ItemsSource="{Binding RecentTransactions}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Пока нет операций. Добавьте первую!"
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           Margin="0,20,0,0" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Transaction">
                        <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Удалить"
                                        BackgroundColor="#D32F2F"
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteTransactionCommand}"
                                        CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        
                            <Border Stroke="LightGray"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="12"
                            Margin="0,4">

                                <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.StartEditCommand}"
                                    CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="*,Auto"
                                    RowDefinitions="Auto,Auto">

                                    <!-- Категория и заметка -->
                                    <Label Grid.Row="0" Grid.Column="0"
                                        Text="{Binding CategoryName}"
                                        FontSize="15"
                                        FontAttributes="Bold" />

                                    <!-- Сумма -->
                                    <Label Grid.Row="0" Grid.Column="1"
                                        Text="{Binding Amount, StringFormat='{0:N0} ₽'}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        HorizontalOptions="End">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                        Binding="{Binding Type}"
                                                        Value="1">
                                                <Setter Property="TextColor" Value="#D32F2F" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label"
                                                        Binding="{Binding Type}"
                                                        Value="0">
                                                <Setter Property="TextColor" Value="#2E7D32" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <!-- Дата и заметка -->
                                    <Label Grid.Row="1" Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        FontSize="12"
                                        TextColor="Gray">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0:dd.MM.yyyy} · {1}">
                                                <Binding Path="Date" />
                                                <Binding Path="Note" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>

                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>