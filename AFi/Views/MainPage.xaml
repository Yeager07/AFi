<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AFi.ViewModels"
             xmlns:models="clr-namespace:AFi.Models"
             xmlns:converters="clr-namespace:AFi.Converters"
             xmlns:controls="clr-namespace:AFi.Controls"
             x:Class="AFi.Views.MainPage"
             x:DataType="vm:MainViewModel"
             x:Name="PageRoot"
             Title="AFi"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </ContentPage.Resources>

    <Grid>
        <ScrollView x:Name="MainScrollView">
            <VerticalStackLayout Padding="20" Spacing="15">

                <!-- ==================== Карточка баланса ==================== -->
                <Border Stroke="{DynamicResource CardBorderColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="20"
                        BackgroundColor="{DynamicResource CardBackgroundColor}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Текущий баланс"
                               FontSize="14"
                               TextColor="{DynamicResource TextSecondaryColor}" />
                        <Label Text="{Binding CurrentBalance, StringFormat='{0:N0} ₽'}"
                               FontSize="30"
                               FontAttributes="Bold">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsBalanceNegative}"
                                             Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource DangerColor}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsBalanceNegative}"
                                             Value="False">
                                    <Setter Property="TextColor" Value="{DynamicResource SuccessColor}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <!-- ==================== Свёрнутая форма ==================== -->
                <Button IsVisible="{Binding ShowCollapsedForm}"
                        Text="+ Добавить операцию"
                        Command="{Binding ExpandFormCommand}"
                        BackgroundColor="{DynamicResource PrimaryColor}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        CornerRadius="12"
                        HeightRequest="56"
                        FontSize="16"
                        FontAttributes="Bold" />

                <!-- ==================== Развёрнутая форма ==================== -->
                <Border IsVisible="{Binding ShowExpandedForm}"
                        Stroke="{DynamicResource CardBorderColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="15"
                        BackgroundColor="{DynamicResource CardBackgroundColor}">
                    <VerticalStackLayout Spacing="10">

                        <!-- Заголовок + кнопка «Свернуть» -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding FormTitle}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   VerticalOptions="Center" />

                            <Button Grid.Column="1"
                                    Text="▾"
                                    Command="{Binding CollapseFormCommand}"
                                    IsVisible="{Binding CanCollapseForm}"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource TextSecondaryColor}"
                                    FontSize="20"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    Padding="0" />
                        </Grid>

                        <!-- ==================== Форма (ContentView) ==================== -->
                        <controls:TransactionFormView FormViewModel="{Binding}" />

                        <!-- ==================== Кнопки формы ==================== -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,10,0,0">
                            <Button Grid.Column="0"
                                    Text="{Binding SubmitButtonText}"
                                    Command="{Binding SaveCommand}"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource PrimaryTextColor}"
                                    CornerRadius="8"
                                    HeightRequest="48" />

                            <Button Grid.Column="1"
                                    Text="Отмена"
                                    Command="{Binding CancelEditCommand}"
                                    IsVisible="{Binding IsEditing}"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource PrimaryColor}"
                                    BorderColor="{DynamicResource PrimaryColor}"
                                    BorderWidth="1"
                                    CornerRadius="8"
                                    HeightRequest="48"
                                    Padding="16,0" />
                        </Grid>

                        <Label Text="{Binding StatusMessage}"
                               FontSize="13"
                               TextColor="{DynamicResource TextSecondaryColor}"
                               HorizontalOptions="Center" />

                    </VerticalStackLayout>
                </Border>

                <!-- ==================== Заголовок списка + кнопка «Выбрать» ==================== -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                    <Label Grid.Column="0"
                           Text="Последние операции"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimaryColor}"
                           VerticalOptions="Center" />

                    <Button Grid.Column="1"
                            Text="Выбрать"
                            Command="{Binding EnterSelectionModeCommand}"
                            IsVisible="{Binding CanEnterSelectionMode}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource PrimaryColor}"
                            BorderColor="{DynamicResource PrimaryColor}"
                            BorderWidth="1"
                            CornerRadius="8"
                            HeightRequest="36"
                            FontSize="13"
                            Padding="12,0" />
                </Grid>

                <!-- ==================== Список операций ==================== -->
                <CollectionView ItemsSource="{Binding TransactionGroups}"
                                IsGrouped="True"
                                SelectionMode="None">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="10" Padding="20">
                            <Label Text="Нет операций за последние 30 дней"
                                   FontSize="14"
                                   TextColor="{DynamicResource TextSecondaryColor}"
                                   HorizontalOptions="Center" />
                            <Button Text="Вся история"
                                    Command="{Binding GoToHistoryCommand}"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource PrimaryTextColor}"
                                    CornerRadius="8"
                                    HeightRequest="44" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.GroupHeaderTemplate>
                        <DataTemplate x:DataType="models:TransactionGroup">
                            <Grid ColumnDefinitions="*,Auto"
                                  Padding="4,12,4,6">
                                <Label Grid.Column="0"
                                       Text="{Binding DateLabel}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource PrimaryColor}" />
                                <Label Grid.Column="1"
                                       Text="{Binding SummaryText}"
                                       FontSize="14"
                                       FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsPositive}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource SuccessColor}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsPositive}"
                                                     Value="False">
                                            <Setter Property="TextColor" Value="{DynamicResource DangerColor}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.GroupHeaderTemplate>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Transaction">
                            <Grid>

                                <!-- ==================== ОБЫЧНЫЙ РЕЖИМ ==================== -->
                                <Border IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsSelectionMode, Converter={StaticResource InverseBoolConverter}}"
                                        Stroke="{DynamicResource CardBorderColor}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="12"
                                        Margin="0,4"
                                        BackgroundColor="{DynamicResource CardBackgroundColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.HandleCardTapCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="*,Auto"
                                          RowDefinitions="Auto,Auto,Auto,Auto">

                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding DisplayCategoryName}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimaryColor}" />

                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Amount, StringFormat='{0:N0} ₽'}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               HorizontalOptions="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding Type}"
                                                             Value="1">
                                                    <Setter Property="TextColor" Value="{DynamicResource DangerColor}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding Type}"
                                                             Value="0">
                                                    <Setter Property="TextColor" Value="{DynamicResource SuccessColor}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <Label Grid.Row="1" Grid.Column="0"
                                               Grid.ColumnSpan="2"
                                               FontSize="12"
                                               TextColor="{DynamicResource TextSecondaryColor}">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0:dd.MM.yyyy} · {1}">
                                                    <Binding Path="Date" />
                                                    <Binding Path="Note" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>

                                        <Grid Grid.Row="2" Grid.Column="0"
                                              Grid.ColumnSpan="2"
                                              IsVisible="{Binding HasExtraDetails}"
                                              Margin="0,6,0,0">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ToggleExpandCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>

                                            <HorizontalStackLayout Spacing="6">
                                                <Label FontSize="11"
                                                       TextColor="{DynamicResource PrimaryColor}"
                                                       VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding IsExpanded}"
                                                                     Value="False">
                                                            <Setter Property="Text" Value="▸" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding IsExpanded}"
                                                                     Value="True">
                                                            <Setter Property="Text" Value="▾" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>

                                                <Label Text="{Binding ExtraDetailsLabel}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{DynamicResource PrimaryColor}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <VerticalStackLayout Grid.Row="3"
                                                             Grid.Column="0"
                                                             Grid.ColumnSpan="2"
                                                             IsVisible="{Binding IsExpanded}"
                                                             Spacing="10"
                                                             Margin="0,8,0,0">

                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}"
                                                                 IsVisible="{Binding HasItems}"
                                                                 Spacing="4">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="models:TransactionItem">
                                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                                              ColumnSpacing="8">
                                                            <Label Grid.Column="0"
                                                                   Text="{Binding Name}"
                                                                   FontSize="12"
                                                                   TextColor="{DynamicResource TextPrimaryColor}"
                                                                   LineBreakMode="TailTruncation" />

                                                            <Label Grid.Column="1"
                                                                   Text="{Binding SummaryText}"
                                                                   FontSize="11"
                                                                   TextColor="{DynamicResource TextSecondaryColor}" />

                                                            <Label Grid.Column="2"
                                                                   Text="{Binding TotalText}"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{DynamicResource TextPrimaryColor}"
                                                                   WidthRequest="70"
                                                                   HorizontalTextAlignment="End" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>

                                            <Border IsVisible="{Binding HasReceipt}"
                                                    Stroke="{DynamicResource CardBorderColor}"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 6"
                                                    Padding="0"
                                                    WidthRequest="100"
                                                    HeightRequest="100"
                                                    HorizontalOptions="Start">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ViewReceiptCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Image Source="{Binding ReceiptImageSource}"
                                                       Aspect="AspectFill" />
                                            </Border>

                                        </VerticalStackLayout>

                                    </Grid>
                                </Border>

                                <!-- ==================== РЕЖИМ ВЫБОРА ==================== -->
                                <Border IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsSelectionMode}"
                                        Stroke="{DynamicResource CardBorderColor}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="12"
                                        Margin="0,4"
                                        BackgroundColor="{DynamicResource CardBackgroundColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.HandleCardTapCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          RowDefinitions="Auto,Auto">

                                        <Border Grid.Row="0" Grid.RowSpan="2"
                                                Grid.Column="0"
                                                WidthRequest="26"
                                                HeightRequest="26"
                                                StrokeShape="RoundRectangle 13"
                                                Stroke="{DynamicResource PrimaryColor}"
                                                StrokeThickness="2"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                VerticalOptions="Center"
                                                HorizontalOptions="Start"
                                                Margin="0,0,10,0">
                                            <Label Text="✓"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource PrimaryColor}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding IsSelected}" />
                                        </Border>

                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding DisplayCategoryName}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimaryColor}" />

                                        <Label Grid.Row="0" Grid.Column="2"
                                               Text="{Binding Amount, StringFormat='{0:N0} ₽'}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               HorizontalOptions="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding Type}"
                                                             Value="1">
                                                    <Setter Property="TextColor" Value="{DynamicResource DangerColor}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding Type}"
                                                             Value="0">
                                                    <Setter Property="TextColor" Value="{DynamicResource SuccessColor}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <Label Grid.Row="1" Grid.Column="1"
                                               Grid.ColumnSpan="2"
                                               FontSize="12"
                                               TextColor="{DynamicResource TextSecondaryColor}">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0:dd.MM.yyyy} · {1}">
                                                    <Binding Path="Date" />
                                                    <Binding Path="Note" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>

                                    </Grid>
                                </Border>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- ==================== Показать ещё / Вся история ==================== -->
                <Button Text="{Binding ShowMoreButtonText}"
                        IsVisible="{Binding HasAnyTransactions}"
                        BackgroundColor="{DynamicResource PrimaryColor}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        CornerRadius="8"
                        HeightRequest="44"
                        Margin="0,5,0,0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding HasMoreInPeriod}"
                                     Value="True">
                            <Setter Property="Command" Value="{Binding LoadMoreCommand}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding HasMoreInPeriod}"
                                     Value="False">
                            <Setter Property="Command" Value="{Binding GoToHistoryCommand}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ==================== Панель мультивыбора ==================== -->
        <Border VerticalOptions="End"
                IsVisible="{Binding IsSelectionMode}"
                BackgroundColor="{DynamicResource ShellBackgroundColor}"
                Stroke="{DynamicResource CardBorderColor}"
                StrokeThickness="1"
                Padding="15,12"
                Margin="0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                <Label Grid.Column="0"
                       Text="✕"
                       FontSize="22"
                       TextColor="{DynamicResource ShellTextColor}"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelSelectionCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Grid.Column="1"
                       Text="{Binding SelectedCount, StringFormat='Выбрано: {0}'}"
                       FontSize="16"
                       TextColor="{DynamicResource ShellTextColor}"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />

                <Button Grid.Column="2"
                        Text="Удалить"
                        Command="{Binding DeleteSelectedCommand}"
                        IsEnabled="{Binding HasSelection}"
                        BackgroundColor="{DynamicResource DangerColor}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        CornerRadius="8"
                        HeightRequest="40"
                        FontSize="14"
                        Padding="16,0" />
            </Grid>
        </Border>

        <!-- ==================== Overlay загрузки ==================== -->
        <Grid IsVisible="{Binding IsInitialLoading}"
              BackgroundColor="{DynamicResource PageBackgroundColor}"
              InputTransparent="False">
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="15">
                <ActivityIndicator IsRunning="True"
                                   Color="{DynamicResource PrimaryColor}"
                                   WidthRequest="50"
                                   HeightRequest="50" />
                <Label Text="Загрузка..."
                       FontSize="15"
                       TextColor="{DynamicResource TextSecondaryColor}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

    </Grid>

</ContentPage>