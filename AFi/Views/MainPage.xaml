<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AFi.ViewModels"
             xmlns:models="clr-namespace:AFi.Models"
             x:Class="AFi.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="AFi">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- ==================== Форма добавления ==================== -->
            <Border Stroke="LightGray"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 10"
            Padding="15">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Новая операция"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <!-- Сумма -->
                    <Label Text="Сумма" FontSize="14" />
                    <Entry Placeholder="Например, 500"
                           Keyboard="Numeric"
                           Text="{Binding AmountText}" />

                    <!-- Тип -->
                    <Label Text="Тип" FontSize="14" />
                    <Picker ItemsSource="{Binding TypeOptions}"
                            SelectedIndex="{Binding SelectedTypeIndex}" />

                    <!-- Категория -->
                    <Label Text="Категория" FontSize="14" />
                    <Picker ItemsSource="{Binding AvailableCategories}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedCategory}" />

                    <!-- Дата -->
                    <Label Text="Дата" FontSize="14" />
                    <DatePicker Date="{Binding Date}" Format="dd.MM.yyyy" />

                    <!-- Комментарий -->
                    <Label Text="Комментарий (необязательно)" FontSize="14" />
                    <Entry Placeholder="Например, закупка зерна"
                           Text="{Binding Note}" />

                    <!-- Кнопка сохранения -->
                    <Button Text="Сохранить"
                            Command="{Binding SaveCommand}"
                            BackgroundColor="#512BD4"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="48"
                            Margin="0,10,0,0" />

                    <!-- Статус -->
                    <Label Text="{Binding StatusMessage}"
                           FontSize="13"
                           TextColor="Gray"
                           HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Border>

            <!-- ==================== Список последних операций ==================== -->
            <Label Text="Последние операции"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <CollectionView ItemsSource="{Binding RecentTransactions}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Пока нет операций. Добавьте первую!"
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           Margin="0,20,0,0" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Transaction">
                        <Border Stroke="LightGray"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="12"
                        Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto">

                                <!-- Категория и заметка -->
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding CategoryName}"
                                       FontSize="15"
                                       FontAttributes="Bold" />

                                <!-- Сумма -->
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Amount, StringFormat='{0:N0} ₽'}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalOptions="End">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Type}"
                                                     Value="1">
                                            <Setter Property="TextColor" Value="#D32F2F" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Type}"
                                                     Value="0">
                                            <Setter Property="TextColor" Value="#2E7D32" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- Дата и заметка -->
                                <Label Grid.Row="1" Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       FontSize="12"
                                       TextColor="Gray">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0:dd.MM.yyyy} · {1}">
                                            <Binding Path="Date" />
                                            <Binding Path="Note" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>