<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AFi.ViewModels"
             xmlns:models="clr-namespace:AFi.Models"
             xmlns:converters="clr-namespace:AFi.Converters"
             xmlns:controls="clr-namespace:AFi.Controls"
             x:Class="AFi.Views.TransactionEditPage"
             x:DataType="vm:TransactionEditViewModel"
             x:Name="PageRoot"
             Title="Редактирование операции"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="12">

            <!-- ==================== Основные поля ==================== -->
            <Border Stroke="{DynamicResource CardBorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="15"
                    BackgroundColor="{DynamicResource CardBackgroundColor}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Сумма (не изменяется)"
                           FontSize="14"
                           TextColor="{DynamicResource TextPrimaryColor}" />
                    <Entry Placeholder="Сумма"
                           Keyboard="Numeric"
                           Text="{Binding AmountText}"
                           TextColor="{DynamicResource TextSecondaryColor}"
                           PlaceholderColor="{DynamicResource TextSecondaryColor}"
                           IsReadOnly="True"
                           BackgroundColor="{DynamicResource DividerColor}"
                           Completed="OnEntryCompleted" />

                    <Label Text="Тип"
                           FontSize="14"
                           TextColor="{DynamicResource TextPrimaryColor}" />
                    <controls:ThemedPicker x:Name="TypePicker"
                                           Title="Тип операции"
                                           IsEnabled="False" />

                    <Label Text="Категория"
                           FontSize="14"
                           TextColor="{DynamicResource TextPrimaryColor}" />
                    <controls:ThemedPicker x:Name="CategoryPicker"
                                           Title="Категория" />

                    <Label Text="Дата"
                           FontSize="14"
                           TextColor="{DynamicResource TextPrimaryColor}" />
                    <DatePicker Date="{Binding Date}"
                                MaximumDate="{Binding MaxDate}"
                                Format="dd.MM.yyyy"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                    <Label Text="Комментарий"
                           FontSize="14"
                           TextColor="{DynamicResource TextPrimaryColor}" />
                    <Entry Placeholder="Комментарий"
                           Text="{Binding Note}"
                           TextColor="{DynamicResource TextPrimaryColor}"
                           PlaceholderColor="{DynamicResource TextSecondaryColor}"
                           Completed="OnEntryCompleted" />

                </VerticalStackLayout>
            </Border>

            <!-- ==================== Позиции чека ==================== -->
            <Border Stroke="{DynamicResource CardBorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="15"
                    BackgroundColor="{DynamicResource CardBackgroundColor}">
                <VerticalStackLayout Spacing="10">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Позиции чека"
                               FontSize="14"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="+ Позиция"
                                Command="{Binding AddItemCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource PrimaryColor}"
                                BorderColor="{DynamicResource PrimaryColor}"
                                BorderWidth="1"
                                CornerRadius="8"
                                HeightRequest="32"
                                FontSize="12"
                                Padding="10,0" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentItems}"
                                         Spacing="6"
                                         IsVisible="{Binding HasItems}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:TransactionItem">
                                <Border Stroke="{DynamicResource CardBorderColor}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="8"
                                        BackgroundColor="{DynamicResource CardBackgroundColor}">
                                    <Grid ColumnDefinitions="*,90,30"
                                          ColumnSpacing="6"
                                          RowDefinitions="Auto,Auto"
                                          RowSpacing="6">

                                        <Entry Grid.Row="0" Grid.Column="0"
                                               Placeholder="Название"
                                               Text="{Binding Name}"
                                               TextColor="{DynamicResource TextPrimaryColor}"
                                               PlaceholderColor="{DynamicResource TextSecondaryColor}"
                                               FontSize="13"
                                               Completed="OnEntryCompleted" />

                                        <Label Grid.Row="0" Grid.RowSpan="2"
                                               Grid.Column="1"
                                               Text="{Binding TotalText}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource PrimaryColor}"
                                               VerticalOptions="Center"
                                               HorizontalTextAlignment="End" />

                                        <Button Grid.Row="0" Grid.RowSpan="2"
                                                Grid.Column="2"
                                                Text="✕"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveItemCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent"
                                                TextColor="{DynamicResource DangerColor}"
                                                WidthRequest="30"
                                                HeightRequest="30"
                                                Padding="0"
                                                FontSize="14"
                                                HorizontalOptions="End"
                                                VerticalOptions="Center"
                                                CornerRadius="15" />

                                        <Grid Grid.Row="1" Grid.Column="0"
                                              ColumnDefinitions="Auto,*,Auto,*"
                                              ColumnSpacing="6">
                                            <Label Grid.Column="0"
                                                   Text="Кол-во:"
                                                   FontSize="12"
                                                   TextColor="{DynamicResource TextSecondaryColor}"
                                                   VerticalOptions="Center" />
                                            <Entry Grid.Column="1"
                                                   Text="{Binding QuantityText}"
                                                   Keyboard="Numeric"
                                                   TextColor="{DynamicResource TextPrimaryColor}"
                                                   PlaceholderColor="{DynamicResource TextSecondaryColor}"
                                                   FontSize="13"
                                                   TextChanged="OnItemEntryChanged"
                                                   Completed="OnEntryCompleted" />
                                            <Label Grid.Column="2"
                                                   Text="Цена:"
                                                   FontSize="12"
                                                   TextColor="{DynamicResource TextSecondaryColor}"
                                                   VerticalOptions="Center" />
                                            <Entry Grid.Column="3"
                                                   Text="{Binding UnitPriceText}"
                                                   Keyboard="Numeric"
                                                   TextColor="{DynamicResource TextPrimaryColor}"
                                                   PlaceholderColor="{DynamicResource TextSecondaryColor}"
                                                   FontSize="13"
                                                   TextChanged="OnItemEntryChanged"
                                                   Completed="OnEntryCompleted" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="{Binding ItemsTotalText}"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource PrimaryColor}"
                           HorizontalOptions="End"
                           IsVisible="{Binding HasItems}" />

                    <Label Text="{Binding AmountMismatchText}"
                           FontSize="11"
                           TextColor="{DynamicResource WarningColor}"
                           HorizontalOptions="End"
                           IsVisible="{Binding HasAmountMismatch}" />

                </VerticalStackLayout>
            </Border>

            <!-- ==================== Фото чека ==================== -->
            <Border Stroke="{DynamicResource CardBorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="15"
                    BackgroundColor="{DynamicResource CardBackgroundColor}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Фото чека"
                           FontSize="14"
                           TextColor="{DynamicResource TextPrimaryColor}" />

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="10"
                          IsVisible="{Binding HasReceipt}">
                        <Border Grid.Column="0"
                                Stroke="{DynamicResource CardBorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="0"
                                WidthRequest="90"
                                HeightRequest="90">
                            <Image Source="{Binding CurrentReceiptImageSource}"
                                   Aspect="AspectFill" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="6"
                                             VerticalOptions="Center">
                            <Button Text="Заменить из галереи"
                                    Command="{Binding PickReceiptFromGalleryCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource PrimaryColor}"
                                    BorderColor="{DynamicResource PrimaryColor}"
                                    BorderWidth="1"
                                    CornerRadius="8"
                                    FontSize="12"
                                    HeightRequest="32" />
                            <Button Text="Удалить фото"
                                    Command="{Binding RemoveReceiptCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource DangerColor}"
                                    BorderColor="{DynamicResource DangerColor}"
                                    BorderWidth="1"
                                    CornerRadius="8"
                                    FontSize="12"
                                    HeightRequest="32" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="8"
                          IsVisible="{Binding HasReceipt, Converter={StaticResource InverseBoolConverter}}">
                        <Button Grid.Column="0"
                                Text="📷 Снять"
                                Command="{Binding CaptureReceiptFromCameraCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource PrimaryColor}"
                                BorderColor="{DynamicResource PrimaryColor}"
                                BorderWidth="1"
                                CornerRadius="8"
                                FontSize="13"
                                HeightRequest="40" />
                        <Button Grid.Column="1"
                                Text="🖼️ Из галереи"
                                Command="{Binding PickReceiptFromGalleryCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource PrimaryColor}"
                                BorderColor="{DynamicResource PrimaryColor}"
                                BorderWidth="1"
                                CornerRadius="8"
                                FontSize="13"
                                HeightRequest="40" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- ==================== Кнопки ==================== -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                <Button Grid.Column="0"
                        Text="Отмена"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource PrimaryColor}"
                        BorderColor="{DynamicResource PrimaryColor}"
                        BorderWidth="1"
                        CornerRadius="8"
                        HeightRequest="48" />
                <Button Grid.Column="1"
                        Text="Сохранить"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="{DynamicResource PrimaryColor}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        CornerRadius="8"
                        HeightRequest="48" />
            </Grid>

            <Label Text="{Binding StatusMessage}"
                   FontSize="13"
                   TextColor="{DynamicResource TextSecondaryColor}"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>