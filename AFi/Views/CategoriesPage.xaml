<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AFi.ViewModels"
             xmlns:models="clr-namespace:AFi.Models"
             x:Class="AFi.Views.CategoriesPage"
             x:DataType="vm:CategoriesViewModel"
             x:Name="PageRoot"
             Title="Категории"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ContentPage.ToolbarItems>
        <!-- ВРЕМЕННО для проверки темизации. Уберём на шаге 3.4.3 -->
        <ToolbarItem x:Name="ThemeIconItem"
                     Text="☀️"
                     Order="Primary"
                     Priority="0"
                     Clicked="OnToggleThemeClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="20"
          RowSpacing="15">

        <!-- ==================== Табы ==================== -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,*"
              ColumnSpacing="8">

            <Button Grid.Column="0"
                    Text="Расходы"
                    Command="{Binding SelectExpensesTabCommand}"
                    CornerRadius="8"
                    HeightRequest="44"
                    FontSize="15">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding SelectedTabIndex}"
                                 Value="0">
                        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
                        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
                        <Setter Property="BorderWidth" Value="0" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding SelectedTabIndex}"
                                 Value="1">
                        <Setter Property="BackgroundColor" Value="Transparent" />
                        <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
                        <Setter Property="BorderColor" Value="{DynamicResource PrimaryColor}" />
                        <Setter Property="BorderWidth" Value="1" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Grid.Column="1"
                    Text="Доходы"
                    Command="{Binding SelectIncomeTabCommand}"
                    CornerRadius="8"
                    HeightRequest="44"
                    FontSize="15">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding SelectedTabIndex}"
                                 Value="1">
                        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
                        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
                        <Setter Property="BorderWidth" Value="0" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding SelectedTabIndex}"
                                 Value="0">
                        <Setter Property="BackgroundColor" Value="Transparent" />
                        <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
                        <Setter Property="BorderColor" Value="{DynamicResource PrimaryColor}" />
                        <Setter Property="BorderWidth" Value="1" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

        </Grid>

        <!-- ==================== Кнопка добавления ==================== -->
        <Button Grid.Row="1"
                Text="+ Добавить категорию"
                Command="{Binding AddCategoryCommand}"
                BackgroundColor="{DynamicResource SuccessColor}"
                TextColor="{DynamicResource PrimaryTextColor}"
                CornerRadius="8"
                HeightRequest="48"
                FontSize="15" />

        <!-- ==================== Список категорий ==================== -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Categories}"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <Label Text="Пока нет категорий"
                       FontSize="14"
                       TextColor="{DynamicResource TextSecondaryColor}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Category">
                    <Border Stroke="{DynamicResource CardBorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="12"
                            Margin="0,4"
                            BackgroundColor="{DynamicResource CardBackgroundColor}">
                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding DisplayName}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       VerticalOptions="Center" />
                                <Label FontSize="11"
                                       TextColor="{DynamicResource TextSecondaryColor}"
                                       Text="Предустановленная"
                                       IsVisible="{Binding IsDefault}" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="Удалить"
                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteCategoryCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource DangerColor}"
                                    BorderColor="{DynamicResource DangerColor}"
                                    BorderWidth="1"
                                    CornerRadius="8"
                                    FontSize="13"
                                    Padding="12,0"
                                    HeightRequest="36">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding IsDefault}"
                                                 Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ==================== Статус ==================== -->
        <Label Grid.Row="3"
               Text="{Binding StatusMessage}"
               FontSize="13"
               TextColor="{DynamicResource TextSecondaryColor}"
               HorizontalOptions="Center" />

    </Grid>

</ContentPage>