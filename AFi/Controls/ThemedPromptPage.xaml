<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AFi.Controls.ThemedPromptPage"
             BackgroundColor="#80000000"
             Shell.NavBarIsVisible="False">

    <Grid>
        <BoxView x:Name="Backdrop" BackgroundColor="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOutsideTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="CardBorder"
                Stroke="{DynamicResource CardBorderColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                Padding="20"
                Margin="20"
                VerticalOptions="Center"
                HorizontalOptions="Fill"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                TranslationY="400"
                Opacity="0">

            <VerticalStackLayout Spacing="15">

                <Label x:Name="TitleLabel"
                       Text="Введите значение"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="MessageLabel"
                       Text=""
                       FontSize="13"
                       TextColor="{DynamicResource TextSecondaryColor}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       IsVisible="False" />

                <Entry x:Name="InputEntry"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       PlaceholderColor="{DynamicResource TextSecondaryColor}"
                       FontSize="15"
                       Completed="OnEntryCompleted" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,5,0,0">

                    <Button x:Name="CancelButton"
                            Text="Отмена"
                            Clicked="OnCancelClicked"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource TextSecondaryColor}"
                            BorderColor="{DynamicResource CardBorderColor}"
                            BorderWidth="1"
                            CornerRadius="8"
                            HeightRequest="44"
                            FontSize="14" />

                    <Button x:Name="AcceptButton"
                            Grid.Column="1"
                            Text="Сохранить"
                            Clicked="OnAcceptClicked"
                            BackgroundColor="{DynamicResource PrimaryColor}"
                            TextColor="{DynamicResource PrimaryTextColor}"
                            CornerRadius="8"
                            HeightRequest="44"
                            FontSize="14" />

                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>